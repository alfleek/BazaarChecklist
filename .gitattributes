# Normalize all text files to LF in the repository.
# Git auto-detects text vs binary; text files are stored as LF and
# checked out as LF on every platform, which stops CRLF/LF diff churn.
* text=auto eol=lf

# Windows-only scripts must stay CRLF to run correctly.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Explicit binary types (never normalized, never diffed as text).
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.jar   binary
*.keystore binary
*.jks   binary
*.so    binary
*.dll   binary
*.bin   binary
